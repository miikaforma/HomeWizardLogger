{
  "TimescaleDB": {
    "Enabled": true,
    "ConnectionString": "Host=127.0.0.1;Username=myuser;Password=mysecretpassword;Database=electricity_test;Port=5432"
  },
  "HomeWizard": {
    "Address": "127.0.0.1",
    "Token": "",
    "UniqueIdOverride": "GID_3"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.SignalR": "Verbose",
        "Microsoft.AspNetCore.Http.Connections": "Verbose"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Verbose"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Verbose"
        }
      }
    ]
  }
}